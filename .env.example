# Copy this file to .env and fill in the values: cp .env.example .env
# Docker Compose reads .env automatically from this directory.

# Password used by all PostgreSQL containers
POSTGRES_PASSWORD=change-me

# Base64-encoded HMAC-SHA256 key (at least 256 bits)
# Generate one with: openssl rand -base64 32
JWT_SECRET=

# Google Gemini API key (used by chatbot-service)
GEMINI_API_KEY=

# Google Cloud Translation API key (used by text-analysis-service)
GOOGLE_TRANSLATE_API_KEY=


# Initial admin account, created on first startup if it does not exist
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me
